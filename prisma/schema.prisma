generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContentBlock {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}
