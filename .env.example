# Neon Postgres connection string (pooled). Get this from your Neon project dashboard.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# Used only by `npm run db:seed` to create/update the single admin login.
# Not read at runtime — safe to remove from your env after seeding.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# Public web3forms access key, used client-side by the contact form.
NEXT_PUBLIC_WEB3FORMS_KEY="a0bf21bf-f1a5-4f30-8a6a-def2264c8e86"
